source "Kconfig.zephyr"

menu "LTEM-NTN Fallback Testbench"

# state machine config (can be board specific)
config APP_GNSS_TIMEOUT_SEC
    int "GNSS timeout in seconds"
    default 120
    range 1 600
    help
      Timeout for GNSS acquisition before continuing. Assisted GNSS can still
      need more than 30 seconds outdoors, especially after a cold start or when
      the antenna view is marginal.

config APP_FORCE_ASSISTED_GNSS_FOR_NTN
    bool "Force assisted GNSS for NTN pre-acquire"
    default n
    help
      Use assisted GNSS for NTN pre-acquire during field testing.

config APP_MODEM_SIGNAL_POLL_INTERVAL_SEC
    int "LTE-M signal poll interval in seconds"
    default 5
    range 1 3600
    help
      Interval used by the modem service when sampling LTE-M RSRP while the
      asset is moving.

config APP_MODEM_SIGNAL_POLL_INTERVAL_STILL_SEC
    int "LTE-M signal poll interval while stationary in seconds"
    default 30
    range 1 3600
    help
      Interval used by the modem service when the accelerometer reports that
      the asset is standing still, or before any valid motion hint is available.

config APP_MODEM_RSRP_FALLBACK_DBM
    int "LTE-M RSRP threshold for NTN fallback"
    default -120
    range -140 -44
    help
      When the measured LTE-M RSRP is at or below this level and continues
      to worsen, the modem service requests NTN fallback.

config APP_MODEM_RSRP_RECOVERY_DBM
    int "NTN->LTE recovery threshold"
    default -110
    range -130 -10
    help
      When LTE-M RSRP is showing signs of improving this value
      decides if it should return to LTE-M-Connetion or not.

config APP_MODEM_RSRP_DROP_DB
    int "LTE-M RSRP drop needed to treat the trend as degrading"
    default 5
    range 1 40
    help
      Minimum drop in dB used by the modem service when deciding that the
      LTE-M signal is degrading toward an NTN fallback.

config APP_MODEM_RSRP_LOSS_SAMPLE_COUNT
    int "Unavailable LTE-M RSRP samples before NTN fallback"
    default 3
    range 1 20
    help
      Number of consecutive failed or unknown RSRP samples needed before the
      modem service treats LTE-M as lost and requests NTN fallback. This avoids
      switching RAT because of one temporary AT command or modem measurement
      failure.

config APP_MODEM_RSRP_WEAK_SAMPLE_COUNT
    int "Weak LTE-M RSRP samples before NTN fallback"
    default 3
    range 1 20
    help
      Number of consecutive valid RSRP samples at or below the fallback
      threshold needed before the modem service requests NTN fallback, even if
      the signal is not actively dropping anymore.

config APP_LTE_BANDLOCK_AT_CMD
    string "LTE bandlock AT command"
    default ""
    help
      Optional AT command sent before LTE connect, e.g. AT%XBANDLOCK=...
      Leave empty to disable bandlock.

config APP_SENSOR_ACCEL_DEMO
    bool "Enable accelerometer demo"
    default y if BOARD_THINGY91X_NRF9151_NS
    default n
    help
      Build the BMI270 accelerometer demo and motion-hint generation.
      Enable this on boards that actually provide a compatible accelerometer.

config APP_SENSOR_ACCEL_MOVING_HOLD_MS
    int "Accelerometer moving hold time in milliseconds"
    default 60000
    range 0 600000
    depends on APP_SENSOR_ACCEL_DEMO
    help
      Keep reporting moving for this long after the last clear acceleration or
      velocity event. This helps smooth vehicle movement keep the faster RSRP
      polling interval even when acceleration is temporarily quiet.

config APP_SENSOR_BATT_DEMO
    bool "Enable battery demo"
    default y if BOARD_THINGY91X_NRF9151_NS
    default n
    help
      Build the nPM1300 battery/charger demo.
      Enable this on boards that actually provide compatible battery hardware.

config APP_SENSOR_TEMP_DEMO
    bool "Enable temperature demo"
    default y if BOARD_THINGY91X_NRF9151_NS
    default n
    help
      Build the BME680 environmental sensor demo.
      Enable this on boards that actually provide a compatible temperature sensor.

config APP_FIELD_LOG
    bool "Enable compact field log"
    default y if APP_SENSOR_BATT_DEMO
    depends on APP_SENSOR_BATT_DEMO
    depends on FLASH
    select FLASH_MAP
    select FLASH_PAGE_LAYOUT
    help
      Build a compact field log for field testing. The logger stores state
      transitions with the best known location and periodic summary records
      in external flash, then exposes them through the serial shell.

config APP_FIELD_LOG_SUMMARY_INTERVAL_SEC
    int "Field log summary interval in seconds"
    default 600
    range 60 3600
    depends on APP_FIELD_LOG
    help
      Interval between summary records.

config APP_FIELD_LOG_STORAGE_BYTES
    int "Field log storage budget in bytes"
    default 16384
    range 4096 1048576
    depends on APP_FIELD_LOG
    help
      Number of bytes reserved from the generated external_flash partition for
      the field log.

config APP_FIELD_LOG_ERASE_BLOCK_SIZE
    int "Field log erase block size"
    default 4096
    range 4096 65536
    depends on APP_FIELD_LOG
    help
      Erase block size used by the external flash device. The Thingy:91 X
      external NOR flash uses 4096-byte erase sectors.

config APP_FIELD_LOG_ERASE_ON_BOOT
    bool "Erase field log storage on boot"
    depends on APP_FIELD_LOG
    help
      Erase the configured field log storage area during startup. This is
      useful during debugging but should be left disabled for field testing.

config APP_FIELD_LOG_SHELL
    bool "Enable field log shell commands"
    default y
    depends on APP_FIELD_LOG
    select SHELL
    select SHELL_BACKEND_SERIAL
    help
      Enable the fieldlog shell command group with info, dump and erase
      commands over the serial shell.

config APP_FIELD_LOG_CONN_EVAL
    bool "Log LTE conn eval samples in field log"
    default y
    depends on APP_FIELD_LOG
    help
      Store LTE connection evaluation metrics as separate field log records.

config APP_CORE_SEND_UDP_DATA
    bool "Send UDP data over NTN"
    help
      Enable UDP sending in the NTN module.

config APP_CORE_SM_PROBE_TEST
    bool "Start dry run for LTE-PROBE"
    help
      Enable LTE-Probe dry run.

config APP_MAX_NTN_RETRIES
    int "Set maximum retry connection attempts for NTN"
    default 3
    help
      Set NTN retries.

config APP_NTN_CONNECT_TIMEOUT_SEC
    int "NTN attach timeout in seconds"
    default 180
    range 30 1800
    help
      Maximum time to wait for NTN attach/registration before retrying.

config APP_MAX_LTEM_RETRIES
    int "Set maximum retry connection attempts for LTEM"
    default 3
    help
      Set LTEM retries.


endmenu


menu "APP Debug Options"

config APP_DEBUG
  bool "Enable debug features"
  default n

config APP_DEBUG_BOOT
  bool "Halt in boot state after initalization"
  depends on APP_DEBUG
  default n
  help 
    Run boot_entry(), but do not transistion out of STATE_BOOT
    when EVT_BOOT is received 

config APP_DEBUG_LTE_CONNECTING
  bool "Halt after LTE registration"
  depends on APP_DEBUG
  default n
  help 
    Allow LTE attach to complete, then stop before transistioning
    STATE_LTEM_CONNECTED

config APP_DEBUG_CLOUD_CONNECTING
  bool "Halt after cloud connection"
  depends on APP_DEBUG
  default n
  help 
    Stop after cloud connection returns success, failure or disconnect,
    instead of continuing to later stages. 

config APP_DEBUG_LTE_LOCATION
  bool "Halt after LTE location result"
  depends on APP_DEBUG
  default n
  help 
    Stop after LTE cellular location returns sucess, failure or timeout, 
    instead of continuing to later stages

config APP_DEBUG_NTN
  bool "Add additional modem info"
  depends on APP_DEBUG
  default n
  help 
    Verbose info from modem

config APP_DEBUG_CORE_UDP_BURST_TEST
  bool "Test burst UDP send function"
  depends on APP_DEBUG
  default n
  help
    Debug UDP burst send

    
  config APP_DEBUG_GNSS_ACQUIRE
  bool "Halt after GNSS result"
  depends on APP_DEBUG
  default n
  help 
    Stop after GNSS returns success or timeout
    instead of continuing to later stages
endmenu

